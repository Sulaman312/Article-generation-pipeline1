CLIENTS_DATA_DIR=clients
API_PORT=8000
UI_PORT=3000
REACT_APP_PROJECT_MODE=article
VITE_PROJECT_MODE=article


ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_API_URL=https://api.perplexity.ai/v1/sonar
PERPLEXITY_MAX_TOKENS=2500
PERPLEXITY_TEMPERATURE=0.15

# Hard gates on draft + final (lede, word count, keyword, audit, FAQ). 1=on.
HARD_GATES_ENABLED=1
# 1=fail the step when gates still fail after one repair attempt.
HARD_GATES_STRICT=1

MONGODB_URI=
MONGODB_DB=article_generation_pipeline

# Login (seeded into MongoDB `users` collection; password stored hashed)
AUTH_DEFAULT_USERNAME=admin
AUTH_DEFAULT_PASSWORD=admin123
AUTH_SESSION_DAYS=14

# Local API: set FLASK_DEBUG=1 only for Werkzeug debugger; keep off by default
FLASK_DEBUG=0
# FLASK_RELOAD=1
