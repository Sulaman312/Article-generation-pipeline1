CLIENTS_DATA_DIR=clients
API_PORT=8000
UI_PORT=3000
REACT_APP_PROJECT_MODE=article
VITE_PROJECT_MODE=article


# LLM via Anthropic SDK. Use either:
#   A) Direct Anthropic: leave ANTHROPIC_BASE_URL empty, CLAUDE_MODEL=claude-sonnet-4-6
#   B) OpenRouter (Claude): set key + base URL + OpenRouter model slug
ANTHROPIC_API_KEY=
# OpenRouter: https://openrouter.ai/api  | Direct Anthropic: leave blank
ANTHROPIC_BASE_URL=https://openrouter.ai/api
# OpenRouter Claude: anthropic/claude-sonnet-4.6
# Direct Anthropic:  claude-sonnet-4-6
CLAUDE_MODEL=anthropic/claude-sonnet-4.6
# Prompt caching (Phase 2): shared client system + fixed shared docs + cache_control.
# Keep provider routing stable via session_id (sent automatically for OpenRouter).
PROMPT_CACHE_ENABLED=1
# Anthropic TTL: 1h (recommended for article runs) or leave empty for 5m default.
PROMPT_CACHE_TTL=1h
# Warn when estimated cacheable prefix is below this (Sonnet 4.6 min is 1024).
PROMPT_CACHE_MIN_TOKENS=1024
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_API_URL=https://api.perplexity.ai/v1/sonar
PERPLEXITY_MAX_TOKENS=2500
PERPLEXITY_TEMPERATURE=0.15

# Hard gates on draft + final (lede, word count, keyword, audit, FAQ). 1=on.
HARD_GATES_ENABLED=1
# 1=fail the step when gates still fail after the repair attempts.
HARD_GATES_STRICT=1

# French quality. 1=on. Used when the article language is French.
# English words, banned words (french_glossary.md), brand terms and placeholders.
FRENCH_QA_ENABLED=1
# French spelling check (needs pyspellchecker). Also runs in the pre-publish check.
FRENCH_SPELLCHECK=1
# Ask the model whether each FAQ answer is French AND answers its question.
FRENCH_FAQ_LLM_CHECK=1
# Rounds of regeneration before a failing step stops (no default text is ever inserted).
QUALITY_RETRY_ATTEMPTS=3
# Claude API attempts per call.
CLAUDE_MAX_ATTEMPTS=3
# Language when the article form does not say (en or fr).
DEFAULT_ARTICLE_LANGUAGE=en

MONGODB_URI=
MONGODB_DB=article_generation_pipeline

# Login (seeded into MongoDB `users` collection; password stored hashed)
AUTH_DEFAULT_USERNAME=admin
AUTH_DEFAULT_PASSWORD=admin123
AUTH_SESSION_DAYS=14

# Local API: set FLASK_DEBUG=1 only for Werkzeug debugger; keep off by default
FLASK_DEBUG=0
# FLASK_RELOAD=1

# Content to CMS — optional GLOBAL defaults only.
# Prefer per-workspace settings (Edit workspace → CMS) in workspace.json.
# Workspace cms.* overrides these when set.
WEBFLOW_TOKEN=
WEBFLOW_COLLECTION_ID=
WEBFLOW_FIELD_BODY=content---1
WEBFLOW_FIELD_RUN_ID=
WEBFLOW_FIELD_META_TITLE=
WEBFLOW_FIELD_META_DESCRIPTION=
WEBFLOW_LIVE_URL_BASE=https://www.yoursite.com/blog
# Designer host slug from https://YOUR-SLUG.design.webflow.com/ (e.g. arsuno-site)
WEBFLOW_SITE_SHORT_NAME=
